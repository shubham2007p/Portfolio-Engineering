# ── Server ──────────────────────────────────────────────────────────────────
PORT=4000
FRONTEND_URL=https://your-portfolio.vercel.app

# ── GitHub ──────────────────────────────────────────────────────────────────
# Personal Access Token — github.com → Settings → Developer settings → Tokens
# Needs read:user and public_repo scopes (or no scopes for public-only data)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxx
GITHUB_USERNAME=shubh-panwar

# ── Email (Nodemailer) ───────────────────────────────────────────────────────
# Use Gmail App Password: google.com → Account → Security → App Passwords
EMAIL_USER=shubham.panwar.dev@gmail.com
EMAIL_PASS=your_16_char_app_password
EMAIL_TO=shubham.panwar.dev@gmail.com
